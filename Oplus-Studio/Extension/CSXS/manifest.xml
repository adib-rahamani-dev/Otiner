<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    ExtensionBundleId="studio.oplus.ae"
    ExtensionBundleName="Otiner Studio"
    ExtensionBundleVersion="1.4.0"
    Version="7.0">
    <ExtensionList>
        <Extension Id="studio.oplus.ae.panel" Version="1.4.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="AEFT" Version="[25.0,25.99]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="12.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="studio.oplus.ae.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./UI/index.html</MainPath>
                    <ScriptPath>./JSX/bootstrap.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Otiner Studio</Menu>
                    <Geometry>
                        <Size>
                            <Height>720</Height>
                            <Width>1120</Width>
                        </Size>
                        <MinSize>
                            <Height>520</Height>
                            <Width>720</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>2160</Height>
                            <Width>3840</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons />
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
