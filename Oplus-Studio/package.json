    "verify": "npm run check && npm test && npm run build",
    "install:dev:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-dev.ps1",
    "install:dev:mac": "bash ./scripts/install-dev.sh"
  },
  "engines": {
    "node": ">=12.22"
  },
