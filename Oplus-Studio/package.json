{
  "name": "oplus-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Production CEP motion-design asset manager for Adobe After Effects 2025.",
  "main": "Engine/index.js",
  "type": "commonjs",
  "scripts": {
    "test": "node Engine/test/run.js",
    "check": "node scripts/check.js",
